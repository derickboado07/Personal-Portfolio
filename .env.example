# Public canonical production URL. Set before building/deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional server-side email delivery. All three values are required.
# Without these, the contact form prepares an honest mailto/email draft.
# Add your real recipient to profile.email in src/data/portfolio.ts as well,
# or set CONTACT_TO_EMAIL alone to use that address for the draft fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Use a sender on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=
